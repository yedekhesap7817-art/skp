 "vo": [
  {
   "t0": 0.2,
   "t1": 2.9,
   "s": "Hangi yemeğe hangi peynir? Dördünü ayıralım."
  },
  {
   "t0": 3.3,
   "t1": 6.9,
   "s": "Mozzarella, pizza ve lazanyada uzayan doku verir."
  },
  {
   "t0": 7.3,
   "t1": 10.5,
   "s": "Taze olanını kullanıyorsan, fazla suyunu süzdür."
  },
  {
   "t0": 11.3,
   "t1": 14.1,
   "s": "Parmesan sert ve yoğun aromalıdır."
  },
  {
   "t0": 14.5,
   "t1": 18.3,
   "s": "Makarna ve risottoya rendeleyerek lezzet katarsın."
  },
  {
   "t0": 19.35,
   "t1": 23.3,
   "s": "Burratanın dışı mozzarella, içi kremalı peynir lifleridir."
  },
  {
   "t0": 23.7,
   "t1": 27.5,
   "s": "Salatada, kızarmış ekmekte veya fırından çıkan pizzada dene."
  },
  {
   "t0": 28.3,
   "t1": 31.35,
   "s": "Cheddar, burger ve tostta belirgin bir tat verir."
  },
  {
   "t0": 31.6,
   "t1": 34.6,
   "s": "Isınınca yumuşar, erir ve yüzeye yayılır."
  },
  {
   "t0": 35.3,
   "t1": 41.9,
   "s": "Kısaca: mozzarella uzatır, parmesan lezzeti yoğunlaştırır, burrata kremamsılık katar; cheddar burger ve tostu tamamlar."
  },
  {
   "t0": 42.1,
   "t1": 43.75,
   "s": "Bir sonraki alışveriş için kaydet."
  }
 ],
